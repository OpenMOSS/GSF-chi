{
  "task": "axial_ecd",
  "description": "Five-run ACMP replication with unit-conditioned frequencies.",
  "source": "matched_axial_seed_expansion_20260827 and matched_axial_five_seed_20260827",
  "args": {
    "modes": [
      "gsf"
    ],
    "seeds": [
      101,
      211,
      307,
      401,
      503
    ],
    "d_model": 48,
    "n_heads": 4,
    "n_layers": 2,
    "dropout": 0.1,
    "gsf_scale": 5.0,
    "device": "cuda",
    "epochs": 25,
    "batch_size": 32,
    "n_chiral_heads": 2,
    "stereo_unit_dropout": 0.2,
    "readout": "parity",
    "number_readout": "ordinal",
    "lr": 0.0003,
    "min_lr": 0.0001,
    "optimizer": "adam",
    "weight_decay": 1e-05,
    "number_ordinal_weight": 1.0,
    "position_ordinal_weight": 0.1,
    "position_risk_weight": 0.1,
    "selection_number_weight": 1.0,
    "selection_position_weight": 0.2,
    "fixed_gsf_frequency": false,
    "output": "outputs/matched/axial_ecd.json"
  }
}
